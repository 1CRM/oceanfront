{
  "name": "of-colorscheme-editor",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "dist/oceanfront-colorscheme-editor.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oceanfront-colorscheme-editor.mjs",
      "default": "./dist/oceanfront-colorscheme-editor.mjs"
    },
    "./css": "./dist/oceanfront-colorscheme-editor.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly && api-extractor run --local && rm -rf dist-types",
    "build-dev": "vite build -m development",
    "package": "yarn pack",
    "clean": "rm -rf .turbo .vite node_modules dist dist-types",
    "coverage": "vitest run --coverage",
    "demo": "vite build -m development --watch",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest --watch=false"
  },
  "peerDependencies": {
    "oceanfront": "*",
    "vue": "~3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/compiler-dom": "~3.5.43",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "oceanfront": "*",
    "prettier": "^3.9.9",
    "tslib": "~2.8.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "vite": "~8.3.1",
    "vitest": "^5.0.3",
    "vue": "~3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.11"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ]
}
