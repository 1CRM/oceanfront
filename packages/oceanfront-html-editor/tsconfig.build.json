{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist-types",
    "noEmit": false,
    "types": ["./src/shims"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-types",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
